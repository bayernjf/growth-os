# growth-os configuration (G1). All credentials are env-only; keys are
# never committed and never stored in the business database.

# HTTP
GROWTH_HOST=127.0.0.1
GROWTH_PORT=8788
# When set, all /api/v1 routes require `Authorization: Bearer <token>`.
GROWTH_API_TOKEN=

# Storage: sqlite (local, default) | postgres (production)
GROWTH_DB_DRIVER=sqlite
# sqlite file path (local dev); use :memory: for ephemeral runs
GROWTH_SQLITE_PATH=./data/growth-os.db
# postgres (production); requires the optional `pg` dependency:
# GROWTH_DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/growth_os

# Read-only search source.
# offline (default): replay deterministic recordings/search/fixtures.json,
# no network and no key needed. G1's whole loop runs offline.
GROWTH_SEARCH_MODE=offline
# online: Tavily-style REST {baseUrl}/search with Bearer auth. Selecting
# online without both values fails closed (HTTP 422), never silently offline.
# GROWTH_SEARCH_MODE=online
# GROWTH_SEARCH_BASE_URL=https://api.example-search.com
# GROWTH_SEARCH_API_KEY=

# Scoring (override defaults; see src/config.ts)
# INSIGHT_MIN_SCORE=60
# REPORT_TOP_N=10
# SCORE_FRESH_HALFLIFE_DAYS=30

# G2 lead pipeline: minimum score for a high-intent signal to be promoted to a lead
# LEAD_MIN_SCORE=60

# G3 outbound decisions (zeus kernel).
# off (default): no decision backend; any outbound flow fails closed (503)
# and never sends without approval.
GROWTH_ZEUS_MODE=off
# online: submit outbound actions to the zeus Decision API for grading.
# Selecting online without both values fails closed (HTTP 422).
# GROWTH_ZEUS_MODE=online
# GROWTH_ZEUS_URL=http://127.0.0.1:8790
# GROWTH_ZEUS_TOKEN=

# G3 outbound email channel (SMTP first) arrives in T-G3-02; see design §13.
